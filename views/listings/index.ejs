<% layout("/layouts/boilerplate") %>
<div class="filters-wrapper">

  <!-- LEFT ARROW -->
  <button class="scroll-arrow left" id="scrollLeft">
    <i class="fa-solid fa-chevron-left"></i>
  </button>

  <!-- SCROLLABLE FILTERS -->
  <div id="filters">
    <div class="filter active">
      <div class="icon"><i class="fa-solid fa-fire"></i></div>
      <p>Trending</p>
    </div>

    <div class="filter">
      <div class="icon"><i class="fa-solid fa-bed"></i></div>
      <p>Rooms</p>
    </div>

    <div class="filter">
      <div class="icon"><i class="fa-solid fa-house"></i></div>
      <p>Entire Home</p>
    </div>

    <div class="filter">
      <div class="icon"><i class="fa-solid fa-water"></i></div>
      <p>Beachfront</p>
    </div>

    <div class="filter">
      <div class="icon"><i class="fa-solid fa-mountain"></i></div>
      <p>Mountains</p>
    </div>

    <div class="filter">
      <div class="icon"><i class="fa-solid fa-city"></i></div>
      <p>City</p>
    </div>

    <div class="filter">
      <div class="icon"><i class="fa-solid fa-tree"></i></div>
      <p>Nature</p>
    </div>

    <div class="filter">
      <div class="icon"><i class="fa-solid fa-snowflake"></i></div>
      <p>Cold Places</p>
    </div>

    <div class="filter">
      <div class="icon"><i class="fa-solid fa-wifi"></i></div>
      <p>Work Friendly</p>
    </div>
  </div>

  <!-- RIGHT ARROW -->
  <button class="scroll-arrow right" id="scrollRight">
    <i class="fa-solid fa-chevron-right"></i>
  </button>

  <!-- TAX TOGGLE -->
  <div id="tax-toggle">
    <div class="form-check form-switch">
      <input class="form-check-input" type="checkbox" id="switchCheckDefault">
      <label class="form-check-label" for="switchCheckDefault">
        Display total after taxes
      </label>
    </div>
  </div>

</div>



  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
    <% for(let listing of allListings){ %>
    <a href="/listings/<%= listing._id %>" class="listing-link">
      <div class="card col">
        <img
          src="<%= listing.image.url %>"
          class="card-img-top"
          alt="listing_image"
          style="height: 20rem"
        />
        <div class="card-img-overlay"></div>
        <div class="card-body">
          <p class="card-text">
            <b><%= listing.title %></b> <br />
            &#8377;<%= listing.price.toLocaleString("en-IN") %> / night
            <i class="taxes">&nbsp; &nbsp; &nbsp; +10% GST</i>
          </p>
        </div>
      </div>
    </a>
    <% } %>
  </div>

<script>
  let toggle=document.getElementById("switchCheckDefault");
  toggle.addEventListener("click",()=>{
    let taxes= document.getElementsByClassName("taxes");

    for(tax of taxes){
      if (tax.style.display!="inline"){
        tax.style.display="inline";
      }else{
        tax.style.display="none"
      }
    };
  });
</script>