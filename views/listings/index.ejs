<% layout("/layouts/boilerplate") %>
<div class="filters-wrapper">

  <!-- LEFT ARROW -->
  <button class="scroll-arrow left" id="scrollLeft">
    <i class="fa-solid fa-chevron-left"></i>
  </button>


  <div id="filters">

  <!-- ALL -->
  <a href="/listings"
     class="filter <%= !selectedCategory ? 'active' : '' %>">
    <div class="icon"><i class="fa-solid fa-fire"></i></div>
    <p>ALL</p>
  </a>

  <!-- ROOMS -->
  <a href="/listings?category=Rooms"
     class="filter <%= selectedCategory === 'Rooms' ? 'active' : '' %>">
    <div class="icon"><i class="fa-solid fa-bed"></i></div>
    <p>Rooms</p>
  </a>

  <!-- ENTIRE HOME -->
  <a href="/listings?category=Entire Home"
     class="filter <%= selectedCategory === 'Entire Home' ? 'active' : '' %>">
    <div class="icon"><i class="fa-solid fa-house"></i></div>
    <p>Entire Home</p>
  </a>

  <!-- BEACHFRONT -->
  <a href="/listings?category=Beachfront"
     class="filter <%= selectedCategory === 'Beachfront' ? 'active' : '' %>">
    <div class="icon"><i class="fa-solid fa-water"></i></div>
    <p>Beachfront</p>
  </a>

  <!-- MOUNTAINS -->
  <a href="/listings?category=Mountains"
     class="filter <%= selectedCategory === 'Mountains' ? 'active' : '' %>">
    <div class="icon"><i class="fa-solid fa-mountain"></i></div>
    <p>Mountains</p>
  </a>

  <!-- CITY -->
  <a href="/listings?category=City"
     class="filter <%= selectedCategory === 'City' ? 'active' : '' %>">
    <div class="icon"><i class="fa-solid fa-city"></i></div>
    <p>City</p>
  </a>

  <!-- NATURE -->
  <a href="/listings?category=Nature"
     class="filter <%= selectedCategory === 'Nature' ? 'active' : '' %>">
    <div class="icon"><i class="fa-solid fa-leaf"></i></div>
    <p>Nature</p>
  </a>

  <!-- COLD PLACES -->
  <a href="/listings?category=Cold Places"
     class="filter <%= selectedCategory === 'Cold Places' ? 'active' : '' %>">
    <div class="icon"><i class="fa-solid fa-snowflake"></i></div>
    <p>Cold</p>
  </a>

  <!-- LUXURY -->
  <a href="/listings?category=Luxury"
     class="filter <%= selectedCategory === 'Luxury' ? 'active' : '' %>">
    <div class="icon"><i class="fa-solid fa-gem"></i></div>
    <p>Luxury</p>
  </a>

  <!-- BUDGET -->
  <a href="/listings?category=Budget Friendly"
     class="filter <%= selectedCategory === 'Budget Friendly' ? 'active' : '' %>">
    <div class="icon"><i class="fa-solid fa-wallet"></i></div>
    <p>Budget</p>
  </a>

  <!-- PET FRIENDLY -->
  <a href="/listings?category=Pet Friendly"
     class="filter <%= selectedCategory === 'Pet Friendly' ? 'active' : '' %>">
    <div class="icon"><i class="fa-solid fa-paw"></i></div>
    <p>Pets</p>
  </a>

  <!-- UNIQUE STAYS -->
  <a href="/listings?category=Unique Stays"
     class="filter <%= selectedCategory === 'Unique Stays' ? 'active' : '' %>">
    <div class="icon"><i class="fa-solid fa-star"></i></div>
    <p>Unique</p>
  </a>

</div>


  <!-- RIGHT ARROW -->
  <button class="scroll-arrow right" id="scrollRight">
    <i class="fa-solid fa-chevron-right"></i>
  </button>

  <!-- TAX TOGGLE -->
  <div id="tax-toggle">
    <div class="form-check form-switch">
      <input class="form-check-input" type="checkbox" id="switchCheckDefault">
      <label class="form-check-label" for="switchCheckDefault">
        Display total after taxes
      </label>
    </div>
  </div>

</div>



  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
    <% for(let listing of allListings){ %>
    <a href="/listings/<%= listing._id %>" class="listing-link">
      <div class="card col">
        <img
          src="<%= listing.image.url %>"
          class="card-img-top"
          alt="listing_image"
          style="height: 20rem"
        />
        <div class="card-img-overlay"></div>
        <div class="card-body">
          <p class="card-text">
            <b><%= listing.title %></b> <br />
            &#8377;<%= listing.price.toLocaleString("en-IN") %> / night
            <i class="taxes">&nbsp; &nbsp; &nbsp; +10% GST</i>
          </p>
        </div>
      </div>
    </a>
    <% } %>
  </div>

<script>
  let toggle=document.getElementById("filter");
  filter.addEventListener("click",()=>{
    let taxes= document.getElementsByClassName("taxes");

    for(tax of taxes){
      if (tax.style.display!="inline"){
        tax.style.display="inline";
      }else{
        tax.style.display="none"
      }
    };
  });
</script>
