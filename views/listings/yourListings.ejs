<% layout("/layouts/boilerplate") %>
<body>
    <div class="container mt-5">
  <h1 class="text-center mb-4">Your Listings</h1>

  <div class="row">
    <% for (const listing of allListings) { %>
      <% if (listing.owner.toString() === owner.toString()) { %>

        <div class="col-md-4 mb-4">
          <div class="card h-100 shadow-sm">

            <img 
              src="<%= listing.image.url %>" 
              class="card-img-top"
              style="height: 200px; object-fit: cover;"
              alt="listing_image"
            >

            <div class="card-body d-flex flex-column">

              <h5 class="card-title"><%= listing.title %></h5>

              <p class="text-muted mb-1">
                Posted by: <strong>@<%= listing.owner.username %></strong>
              </p>

              <p class="card-text">
                <strong>Description:</strong><br>
                <%= listing.description %>
              </p>

              <p class="mb-1">
                <strong>Price:</strong> ₹ <%= listing.price.toLocaleString("en-IN") %>
              </p>

              <p class="mb-1">
                <strong>Location:</strong> 
                <%= listing.location %>, <%= listing.country %>
              </p>

              <p class="mb-3">
                <strong>Category:</strong> <%= listing.categories %>
              </p>

              <!-- ✅ Edit & Delete Buttons -->
              <% if (currUser && currUser._id.equals(listing.owner._id)) { %>
                <div class="mt-auto d-flex justify-content-between">

                  <a
                    href="/listings/<%= listing._id %>/edit"
                    class="btn btn-outline-dark btn-sm"
                  >
                    Edit
                  </a>

                  <form 
                    method="post" 
                    action="/listings/<%= listing._id %>?_method=DELETE"
                  >
                    <button class="btn btn-outline-danger btn-sm">
                      Delete
                    </button>
                  </form>

                </div>
              <% } %>

            </div>
          </div>
        </div>

      <% } %>
    <% } %>
  </div>
</div>
  
</body>
